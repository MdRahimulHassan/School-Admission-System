# Optional. Copy to ".env" to override the defaults used by docker-compose.yml.
# Without a .env file everything runs with the values the assignment specifies.

# How long a seat stays reserved after applying, in seconds.
HOLD_DURATION_SECONDS=600

# Host port for the backend. Change only if 8080 is already taken on your machine.
BACKEND_PORT=8080

# Host port for the UI.
FRONTEND_PORT=5173

# Backend URL the UI calls from the browser. Defaults to http://localhost:<BACKEND_PORT>.
# VITE_API_BASE_URL=http://localhost:8080

# Host port of the optional second backend (docker compose --profile two-backends up).
BACKEND_2_PORT=8081

# Point the backend at a different PostgreSQL. Keyword or URL format both work:
# DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=admission;Username=admission;Password=admission
# DB_CONNECTION_STRING=postgres://admission:admission@postgres:5432/admission
